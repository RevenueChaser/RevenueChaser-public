{# Runs tab (/view/runs): the read-only run log over job_runs. Rendered by app/runview.py with autoescape
   on; the payload arrives as Markup from html_safe.script_json. Every stored value — a module name, a job
   message, a params blob — is untrusted text and goes into the page through textContent only. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Runs</title>
<link rel="icon" href="/static/icons/icon-192.png">
{%- set columns = ["Started", "Job", "Trigger", "Status", "Took", "Steps", "Note", "Counts", "Params"] %}
<style>
/* Dark is the dashboard's own look and the default on every device: no data-theme is dark. The shell copies
   its choice onto this document; data-theme="light" is light, and "auto" follows the device (mirrors
   core/reporting_common.THEME_CSS). */
:root{--bg:#05111F;--panel:#12161e;--panel2:#1a1f2b;--border:#232a38;
--text:#d7dce5;--muted:#8a93a6;--accent:#0EA5E9;--red:#e74c3c;--green:#2ecc71;--amber:#f0ad4e;color-scheme:dark}
@media (prefers-color-scheme: light){
  :root[data-theme="auto"]{--bg:#f5f7fa;--panel:#ffffff;--panel2:#eef1f5;--border:#d5dbe3;
    --text:#1b2330;--muted:#5b6575;--accent:#0369a1;--red:#c0392b;--green:#1e8449;--amber:#a15c00;color-scheme:light}
}
:root[data-theme="light"]{--bg:#f5f7fa;--panel:#ffffff;--panel2:#eef1f5;--border:#d5dbe3;
  --text:#1b2330;--muted:#5b6575;--accent:#0369a1;--red:#c0392b;--green:#1e8449;--amber:#a15c00;color-scheme:light}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5}
.wrap{display:flex;flex-direction:column;height:100%;padding:20px 24px 12px}
.topbar{border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:12px}
.topbar h1{margin:0;font-size:22px;letter-spacing:-.4px}
.topbar .sub{color:var(--muted);margin-top:2px;font-size:13px}
.controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
.chk{display:inline-flex;align-items:center;gap:5px;font-size:13px;cursor:pointer;user-select:none}
.chk input{margin:0;accent-color:var(--accent)}
.fld{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.fld input,.fld select{background:var(--panel);border:1px solid var(--border);color:var(--text);border-radius:6px;height:32px;padding:0 10px;font:inherit;font-size:13px;width:160px}
.btn{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;height:32px;padding:0 14px;font:600 13px/1 inherit;cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn[aria-pressed="true"]{border-color:var(--accent);color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.meta,.note{color:var(--muted);font-size:12.5px;line-height:1.5;margin:8px 0 0}
.meta{overflow-wrap:anywhere}   /* it quotes the name filter, which may be one long word */
.note{border-top:1px solid var(--border);padding-top:8px;margin-top:8px}
.scroll{flex:1 1 auto;min-height:160px;overflow:auto;margin:8px 0 0;background:var(--panel);border:1px solid var(--border);border-radius:12px}
table{border-collapse:collapse;width:100%;font-size:13px}
thead th{position:sticky;top:0;background:var(--panel2);text-align:left;font-weight:600;color:var(--muted);
  padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;z-index:1}
tbody td{padding:7px 10px;border-bottom:1px solid var(--border);vertical-align:top}
tbody tr:last-child td{border-bottom:0}
td.when,td.took{white-space:nowrap;font-variant-numeric:tabular-nums}
td.job{font-weight:600;overflow-wrap:anywhere}
td.note-cell,td.params{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;
  max-width:28ch;overflow-wrap:anywhere}
td.dash{color:var(--muted)}
.pill{display:inline-block;border:1px solid var(--border);border-radius:999px;padding:1px 8px;font-size:12px;font-weight:600}
.s-done{color:var(--green)}
.s-error,.s-cancelled{color:var(--red)}
.s-running,.s-queued{color:var(--amber)}
.empty{padding:16px 12px;color:var(--muted)}
.clip-full{display:none}
/* The day strip: what today cost, and whether every run left a record (#1205). */
.tiles{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0}
.tile{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:8px 12px;flex:1 1 150px;min-width:0}
.tile .n{font-size:20px;font-weight:700;letter-spacing:-.4px;font-variant-numeric:tabular-nums}
.tile .l{color:var(--muted);font-size:12.5px;margin-top:1px;overflow-wrap:anywhere}
.tile.bad{border-color:var(--red)}
.tile.bad .n{color:var(--red)}
.tile.ok .n{color:var(--green)}
/* A chain is one block: its header row, then its runs. The header says what the whole chain cost. */
tbody tr.chain td{background:var(--panel2);border-bottom:1px solid var(--border)}
td.chain-cell{font-weight:600;overflow-wrap:anywhere}
td.chain-cell .c-meta{color:var(--muted);font-weight:400;margin-left:8px;font-size:12.5px}
td.chain-cell .c-bad{color:var(--red);font-weight:600}
tbody tr.member td.when{padding-left:22px}
td.steps{color:var(--muted);font-size:12.5px;max-width:34ch;overflow-wrap:anywhere}
td.steps b{color:var(--text);font-weight:600}
/* A finger, not a mouse: every control is at least 44 px tall (the owner's phone rule, CLAUDE.md). */
@media (max-width: 640px), (pointer: coarse){
  .chk{min-height:44px}
  .chk input{width:22px;height:22px}
  .fld input,.fld select,.btn{height:44px;font-size:16px}
  .btn{min-width:88px}
}
/* A phone: one card per run, each cell on its own line under its column's name, nothing sideways.
   The page scrolls instead of the table box, so the cards use the whole height. */
@media (max-width: 640px){
  html,body{height:auto}
  .wrap{height:auto;padding:12px 16px}
  .controls{flex-direction:column;align-items:stretch;gap:8px}
  .fld{width:100%}
  .fld label{min-width:3.5em}
  .fld input,.fld select{flex:1 1 auto;width:auto;min-width:0}
  .scroll{overflow:visible;background:none;border:0;border-radius:0;min-height:0}
  table,tbody,tr,td{display:block;width:100%}
  thead{display:none}   /* each cell shows its column's name instead (below); many screen readers read it out too */
  tbody tr{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:6px 12px;margin:0 0 8px}
  tbody td{display:grid;grid-template-columns:5.5em minmax(0,1fr);gap:8px;padding:4px 0;border:0;max-width:none}
  tbody tr:last-child td{border:0}
  tbody td.note-cell,tbody td.params{max-width:none}
  tbody td .pill{justify-self:start}
  tbody td .clip-short{display:none}
  tbody td .clip-full{display:block;min-width:0}
  {%- for name in columns %}
  tbody td:nth-child({{ loop.index }})::before{content:"{{ name }}";color:var(--muted);font:500 12px/1.6 -apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  {%- endfor %}
  tbody td.empty{display:block}
  tbody td.empty::before{content:none}
  tbody tr.chain{background:var(--panel2)}
  tbody tr.chain td{display:block;background:none}
  tbody td.chain-cell::before{content:none}
  tbody td.chain-cell .c-meta{display:block;margin:2px 0 0}
  tbody tr.member td.when{padding-left:0}
  tbody td.steps{max-width:none}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <h1>Runs</h1>
    <div class="sub">Every run this store recorded, newest first: a builder dataset run, a scheduled task or a
      dashboard job, with the seconds each step took and the chain it belongs to
      (<code>job_runs2</code>). Read-only.</div>
  </div>
  <div class="tiles" id="runs-tiles"></div>
  <div class="controls">
    <label class="chk" for="runs-problems"><input type="checkbox" id="runs-problems"> Problems only</label>
    <label class="chk" for="runs-chains"><input type="checkbox" id="runs-chains" checked> Group by chain</label>
    <span class="fld"><label for="runs-filter">Job</label><input type="text" id="runs-filter" placeholder="name contains…"></span>
    <span class="fld"><label for="runs-limit">Show</label><select id="runs-limit" autocomplete="off">
      {%- for n in limits %}<option value="{{ n }}"{% if loop.first %} selected{% endif %}>newest {{ n }}</option>{% endfor -%}
    </select></span>
    <button type="button" class="btn" id="runs-pause" aria-pressed="false">Pause</button>
  </div>
  <div class="scroll">
    <table>
      <thead><tr>
        {%- for name in columns %}<th scope="col">{{ name }}</th>{% endfor -%}
      </tr></thead>
      <tbody id="runs-body"><tr><td class="empty" colspan="{{ columns | length }}">Loading...</td></tr></tbody>
    </table>
  </div>
  <p class="meta" id="runs-meta" aria-live="polite"></p>
  <p class="note">A dash under Trigger means an older row that recorded none: a dashboard job writes
    <em>dashboard</em>, a scheduled task <em>schedule</em>, a builder run what asked for it. A run left on
    <em>running</em> may still be going, or its end write was skipped; a row older than its bound whose process is
    gone is closed as <em>lost</em> (outcome unknown, no end time recorded). <b>Steps</b> are the seconds inside one
    run, recorded since the run record of 20 Nov 2026; a run older than that has none, and a dash is not a zero.
    A <b>chain</b> is a scheduled task's own run and the runs it caused: its header line is the whole chain's span,
    and <em>busy</em> is the sum of its runs. <b>Records</b> counts the chains whose own outer run left no row and
    the rows with no chain id at all; the matching count for the server's timers is on the Grafana Jobs board.</p>
</div>
<script>
var INITIAL = {{ initial_json }};
var POLL = "/api/runs";   // app/runview.POLL_PATH
(function () {
  var body = document.getElementById("runs-body"), meta = document.getElementById("runs-meta");
  var problems = document.getElementById("runs-problems"), filter = document.getElementById("runs-filter");
  var pause = document.getElementById("runs-pause"), limit = document.getElementById("runs-limit");
  var chains = document.getElementById("runs-chains"), tiles = document.getElementById("runs-tiles");
  var DEFAULT_LIMIT = "{{ limits[0] }}";   // app/runview.DEFAULT_LIMIT: the page the URL omits
  var COLUMNS = {{ columns | length }};      // the header's own column count
  var paused = false, busy = false, pending = false, shown = null, last = null;

  function stamp(epoch) {
    if (epoch === null || epoch === undefined) return "—";
    var d = new Date(epoch * 1000);
    if (isNaN(d)) return "—";
    var p = function (n) { return String(n).padStart(2, "0"); };
    return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + " "
         + p(d.getHours()) + ":" + p(d.getMinutes());
  }

  function took(secs) {
    if (secs === null || secs === undefined) return "";
    var s = Math.round(secs);
    if (s < 60) return s + "s";
    var m = Math.floor(s / 60);
    if (m < 60) return m + "m " + (s % 60) + "s";
    return Math.floor(m / 60) + "h " + (m % 60) + "m";
  }

  function text(value) {
    if (value === null || value === undefined || value === "") return "";
    if (typeof value === "object") { try { return JSON.stringify(value); } catch (e) { return String(value); } }
    return String(value);
  }

  // A params blob or a traceback can be hundreds of characters; the cell shows the start and keeps the whole
  // of it in the tooltip. Both go in as text (textContent, and title as a DOM property): never markup.
  var CLIP = 64;

  function cell(row, cls, value, clip) {
    var td = document.createElement("td");
    td.className = cls;
    var s = text(value);
    if (!s) { td.classList.add("dash"); s = "—"; }
    if (clip && s.length > CLIP) {
      // Clipped on a desktop with the whole value in the tooltip; a phone has no tooltip, so it shows the
      // whole value instead (CSS picks the span). Both are text nodes: never markup.
      td.title = s;
      var short = document.createElement("span"), full = document.createElement("span");
      short.className = "clip-short";
      short.textContent = s.slice(0, CLIP) + "…";
      full.className = "clip-full";
      full.textContent = s;
      td.appendChild(short);
      td.appendChild(full);
      row.appendChild(td);
      return td;
    }
    td.textContent = s;               // a stored message is untrusted text: never markup
    row.appendChild(td);
    return td;
  }

  // The seconds inside a run, in the order they ran: "fetch 12s · build 4m 2s · swap 3s". The longest step is
  // the one a reader is looking for, so it is the one in bold. A run recorded before the step record has none,
  // and the cell shows a dash rather than a zero.
  function stepsCell(row, steps) {
    var td = document.createElement("td");
    td.className = "steps";
    if (!steps || !steps.length) { td.className = "steps dash"; td.textContent = "—"; row.appendChild(td); return; }
    var top = steps.reduce(function (a, b) { return (b.seconds || 0) > (a.seconds || 0) ? b : a; }, steps[0]);
    td.title = steps.map(function (s) { return s.name + " " + took(s.seconds); }).join(" · ");
    // One wrapper, not a run of text nodes: on a phone the cell itself is a two-column grid (label, value),
    // and every child of it would otherwise be laid out as its own row, one step per line with a stray dot.
    var box = document.createElement("span");
    steps.forEach(function (s, i) {
      if (i) box.appendChild(document.createTextNode(" · "));
      var el = document.createElement(s === top && steps.length > 1 ? "b" : "span");
      el.textContent = s.name + " " + took(s.seconds);     // a stored step name is text: never markup
      box.appendChild(el);
    });
    td.appendChild(box);
    row.appendChild(td);
  }

  // A chain's own line: the task that ran, what the whole chain spanned, how many runs it holds. It carries no
  // status pill of its own — the runs under it do — but a chain with a failed run says so in red.
  function chainLine(c) {
    var tr = document.createElement("tr");
    tr.className = "chain";
    var td = document.createElement("td");
    td.className = "chain-cell";
    td.colSpan = COLUMNS;
    td.textContent = text(c.name) || "(no name)";
    var m = document.createElement("span");
    m.className = "c-meta";
    var parts = [stamp(c.started_at)];
    parts.push(c.running ? "going" : "span " + took(c.seconds));
    parts.push("busy " + took(c.busy_s));
    parts.push(c.runs + (c.runs === 1 ? " run" : " runs"));
    m.textContent = parts.join(" · ");
    td.appendChild(m);
    if (c.bad) {
      var b = document.createElement("span");
      b.className = "c-meta c-bad";
      b.textContent = c.bad + " failed";
      td.appendChild(b);
    }
    tr.appendChild(td);
    return tr;
  }

  // The day strip: the newest day the page read, and the record audit beside it. "Records" is red only when a
  // run really left no row; when the store could not be asked it says "not checked", never "0 missing".
  function drawTiles(d) {
    var day = (d.days || [])[0], a = d.audit || {};
    var gaps = (a.missing_root || 0) + (a.no_chain || 0);
    var items = [
      {n: day ? String(day.runs) : "0", l: day ? "runs on " + day.day : "no run read", cls: ""},
      {n: day ? took(day.seconds) : "—", l: "time recorded" + (day && day.running ? " · " + day.running + " going" : ""), cls: ""},
      {n: day ? String(day.failed) : "0", l: "failed", cls: day && day.failed ? "bad" : "ok"},
      {n: a.checked ? String(gaps) : "—", l: a.checked ? "runs with no record" : "records not checked",
       cls: a.checked ? (gaps ? "bad" : "ok") : ""}
    ];
    var frag = document.createDocumentFragment();
    items.forEach(function (it) {
      var box = document.createElement("div");
      box.className = "tile " + it.cls;
      var n = document.createElement("div"), l = document.createElement("div");
      n.className = "n"; n.textContent = it.n;
      l.className = "l"; l.textContent = it.l;
      box.appendChild(n); box.appendChild(l);
      frag.appendChild(box);
    });
    tiles.replaceChildren(frag);
  }

  function line(r) {
    var tr = document.createElement("tr");
    cell(tr, "when", stamp(r.started_at === null || r.started_at === undefined ? r.queued_at : r.started_at));
    cell(tr, "job", r.module);
    cell(tr, "trigger", r.trigger);
    var st = document.createElement("td");
    var pill = document.createElement("span");
    pill.className = "pill s-" + String(r.status || "").replace(/[^a-z]/gi, "");
    pill.textContent = text(r.status) || "—";
    st.appendChild(pill);
    tr.appendChild(st);
    cell(tr, "took", r.status === "running" ? "going" : took(r.duration_s));
    stepsCell(tr, r.steps);
    cell(tr, "note-cell", r.error || r.message, true);
    // #136: what the run did. A run that reported no number has none: the cell shows a dash, never a zero.
    cell(tr, "params counts", r.counts && Object.keys(r.counts).length ? r.counts : "", true);
    cell(tr, "params", r.params && Object.keys(r.params).length ? r.params : "", true);
    return tr;
  }

  // What the meta line says. It names the filter the rows were read under, so "0 of 0 problem runs" can
  // never be read as "no run ever failed" when only the newest page was looked at.
  // What the meta line says. It names the window the rows were read under, so "0 problem runs" can never be
  // read as "no run ever failed" when only the newest page was looked at.
  function metaText(d, paused) {
    var kind = d.problems ? " problem runs" : " runs";
    if (d.query) kind += ' matching "' + d.query + '"';
    var line = d.shown + kind + " of the newest " + (d.read || 0) + " recorded";
    if (d.audit && d.audit.checked && d.audit.missing_root) {
      line += " · " + d.audit.missing_root + " chain" + (d.audit.missing_root === 1 ? "" : "s")
            + " whose own run left no row";
    }
    if (d.audit && d.audit.checked && d.audit.no_chain) {
      line += " · " + d.audit.no_chain + " row" + (d.audit.no_chain === 1 ? "" : "s") + " with no chain id";
    }
    if (d.ok === false) line += " · the run log could not be read";
    return line + (paused ? " · paused" : "");
  }

  function draw() {
    if (!last) return;
    var rows = last.rows || [], grouped = chains.checked;
    var key = JSON.stringify([grouped, rows.map(function (r) { return [r.run_id, r.status, r.finished_at]; })]);
    if (key !== shown) {                  // unchanged: keep the reader's scroll and selection
      shown = key;
      var frag = document.createDocumentFragment();
      if (!rows.length) {
        var tr = document.createElement("tr"), td = document.createElement("td");
        td.className = "empty";
        td.colSpan = COLUMNS;
        td.textContent = (last.problems || last.query) ? "No run matches this filter."
                                                       : "No run has been recorded yet.";
        tr.appendChild(td);
        frag.appendChild(tr);
      } else if (grouped) {
        // The chains the server grouped, each with its runs under it. A chain of one run gets no header line:
        // the run is the whole story, and a header would double every line of a day of single runs.
        var byId = {};
        rows.forEach(function (r) { byId[r.run_id] = r; });
        (last.chains || []).forEach(function (c) {
          if (c.runs > 1) frag.appendChild(chainLine(c));
          (c.run_ids || []).forEach(function (id) {
            var r = byId[id];
            if (!r) return;
            var tr = line(r);
            if (c.runs > 1) tr.className = "member";
            frag.appendChild(tr);
          });
        });
      } else {
        rows.forEach(function (r) { frag.appendChild(line(r)); });
      }
      body.replaceChildren(frag);
    }
    drawTiles(last);
    meta.textContent = metaText(last, paused);
  }

  // A board iframe the shell is not showing still runs its timers: poll only while this one is on screen.
  function onScreen() {
    if (document.hidden) return false;
    try { var f = window.frameElement; return !f || f.getClientRects().length > 0; } catch (e) { return true; }
  }

  function query() {
    var p = new URLSearchParams();
    if (problems.checked) p.set("problems", "1");
    var q = filter.value.trim();
    if (q) p.set("q", q);
    if (limit.value && limit.value !== DEFAULT_LIMIT) p.set("limit", limit.value);
    var s = p.toString();
    return s ? POLL + "?" + s : POLL;
  }

  // A read already in flight does not drop a reader's change: it is remembered and sent once that read ends
  // (one extra request at most, however many changes came meanwhile). A timer poll that finds a read in
  // flight is simply skipped; the next tick comes round anyway.
  function load(poll) {
    if (busy) { if (!poll) pending = true; return; }
    busy = true;
    var url = query();
    fetch(url, {cache: "no-store"})
      .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      // An answer read under a filter the reader has since changed is dropped, and so is its failure: the
      // pending read follows.
      .then(function (d) { if (url === query() && !(poll && paused)) { last = d; draw(); } })
      .catch(function (e) { if (url === query()) meta.textContent = "Could not read the run log: " + e.message; })
      .then(function () { busy = false; if (pending) { pending = false; load(); } });
  }

  problems.addEventListener("change", function () { shown = null; load(); });
  // Grouping is a view of the rows already in hand: it redraws, it does not read again.
  chains.addEventListener("change", function () { shown = null; draw(); });
  limit.addEventListener("change", function () { shown = null; load(); });
  var typing = null;
  filter.addEventListener("input", function () {
    clearTimeout(typing);
    typing = setTimeout(function () { shown = null; load(); }, 250);   // one read per pause, not per key
  });
  pause.addEventListener("click", function () {
    paused = !paused;
    pause.textContent = paused ? "Resume" : "Pause";
    pause.setAttribute("aria-pressed", paused ? "true" : "false");
    if (!paused) load();
  });
  document.addEventListener("visibilitychange", function () { if (!paused && onScreen()) load(true); });
  setInterval(function () { if (!paused && onScreen()) load(true); }, 5000);
  if (INITIAL && INITIAL.rows) { last = INITIAL; draw(); } else { load(); }
})();
</script>
</body>
</html>
