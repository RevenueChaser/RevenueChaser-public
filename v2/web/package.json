{
  "name": "revenuechaser-v2-web",
  "version": "0.0.0",
  "private": true,
  "description": "RevenueChaser v2 web interface. Static files, served by the v2 door. Stack ADR: ../README.md",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "licences": "node tools/check-licences.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
